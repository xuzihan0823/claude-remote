{
  "expo": {
    "name": "Claude Remote",
    "slug": "claude-remote",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "claude-remote",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "cc.anyyu.clauderemote.rn",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "NSLocalNetworkUsageDescription": "连接局域网内 Mac 上的 Claude Code daemon",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "cc.anyyu.clauderemote",
      "adaptiveIcon": {
        "backgroundColor": "#F5F4EF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-blank.png",
          "imageWidth": 1,
          "backgroundColor": "#FAF9F6",
          "dark": {
            "backgroundColor": "#141414"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "扫描 Mac 上的配对二维码，以及拍照发给 Claude",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "选择照片发给 Claude",
          "cameraPermission": "扫描 Mac 上的配对二维码，以及拍照发给 Claude",
          "microphonePermission": false
        }
      ]
    ]
  }
}
