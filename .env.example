# claude-remote daemon 环境变量（复制为 .env 后填写；变量语义见 docs/api-contract.md）

# 应用层鉴权 token（必填；缺失时 daemon 拒绝启动）
BRIDGE_TOKEN=

# 监听地址（默认 127.0.0.1；Tailscale 部署时设为 Tailscale IP 或 0.0.0.0 由防火墙约束）
BRIDGE_HOST=127.0.0.1
# 端口
BRIDGE_PORT=8787

# 数据源（默认 ~/.claude/projects；测试注入 fixture 用）
CLAUDE_PROJECTS_DIR=

# terminal-driving 回落 idle 的静默期（毫秒）
ACTIVITY_COOLDOWN_MS=120000

# 审批状态库路径
INTERACTIONS_DB_PATH=.data/interactions.sqlite
# 审批超时（毫秒，超时即 deny）
PERMISSION_TIMEOUT_MS=300000

# 推送通知（可选，二选一）
BARK_URL=
NTFY_URL=

# 手机端上传附件的落盘目录（默认 ~/.claude-remote/uploads）
# UPLOADS_DIR=

# claude 可执行文件显式路径（可选；GUI 壳 app 子进程无 shell PATH 时由壳注入）
# CLAUDE_BIN=


# 自建 relay（仅由 cr relay add/on/off/remove 管理，不要手改）
# 原有键为第一台，后续编号必须从 2 连续递增，每台地址和密钥必须齐全且地址不能重复
# RELAY_URL=https://relay-a.example.com
# RELAY_SECRET=
# RELAY_URL_2=https://relay-b.example.com
# RELAY_SECRET_2=
# 所有 relay 共用设备身份和总开关；只添加自己控制的服务器
# RELAY_DEVICE_ID=
# RELAY_DEVICE_KEY=
# RELAY_ENABLED=on
# remove <地址> 保留设备身份；remove --all 清除全部配置和设备私钥
